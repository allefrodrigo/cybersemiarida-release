; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="cybersemiarida"
run/main_scene="res://scenes/main_title.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CheckpointManager="*res://singleton/CheckpointManager.gd"
DialogManager="*res://prefabs/dialog_manager.tscn"
GameManager="*res://scripts/GameManager.gd"
MusicPlayer="*res://scripts/music_player.gd"
FallManager="*res://scripts/FallManager.gd"
GameState="*res://scripts/GameState.gd"
global_accesibility_signal="*res://addons/accesibilitytools/global_accesibility_signal.gd"
ColorBlindLayer="*res://colorblind_shaderscreen.tscn"

[dialogue_manager]

general/balloon_path="res://dialogues/balloon.tscn"

[display]

window/size/viewport_width=272
window/size/viewport_height=153
window/size/mode=3
window/size/window_width_override=1904
window/size/window_height_override=1071
window/stretch/mode="canvas_items"
window/stretch/scale=0.7
window/name="beta-cybersemiarida"

[editor_plugins]

enabled=PackedStringArray("res://addons/accesibilitytools/plugin.cfg")

[global_group]

player=""
checkpoints=""

