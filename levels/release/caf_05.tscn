[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

@onready var timer_label: Label
@onready var circle_spawner: Node2D = $CircleSpawner
@onready var player: CharacterBody2D = $Player

func _ready() -> void:
	# Cria um label para mostrar o tempo restante
	timer_label = Label.new()
	timer_label.position = Vector2(10, 10)
	timer_label.add_theme_font_size_override(\"font_size\", 24)
	add_child(timer_label)
	
	# Conecta os sinais
	circle_spawner.game_finished.connect(_on_game_finished)
	circle_spawner.player_hit_reset_phase.connect(_on_player_hit_reset)
	
	print(\"Fase caf_05 iniciada - Desvie dos círculos por 60 segundos!\")

func _process(_delta: float) -> void:
	if timer_label and circle_spawner:
		var time_left = circle_spawner.get_remaining_time()
		timer_label.text = \"Tempo: \" + str(int(time_left)) + \"s\"

func _on_game_finished() -> void:
	print(\"Parabéns! Você sobreviveu aos círculos!\")
	# Aqui você pode adicionar lógica para passar para a próxima fase
	# ou mostrar uma tela de vitória

func _on_player_hit_reset() -> void:
	# Usa o método de respawn do player
	if player.has_method(\"respawn_to_initial\"):
		player.respawn_to_initial()
	else:
		# Fallback: reseta posição manualmente
		player.global_position = Vector2(126, 125)
		player.velocity = Vector2.ZERO
	
	# Reseta o jogo
	circle_spawner.reset_game()
	
	print(\"Fase resetada!\")
"

